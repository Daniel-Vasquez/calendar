# Copia este archivo a `.env` para el desarrollo local. En producción, las
# mismas variables se definen en el panel de Vercel: el `.env` no se sube.

# Cadena de conexión de MongoDB Atlas.
MONGODB_URI="mongodb+srv://usuario:contraseña@clúster.mongodb.net/planificador?retryWrites=true&w=majority"

# Opcional. Manda sobre el nombre que traiga la URI; sin ninguno de los dos
# se usa `planificador`. Útil para apuntar a una base de pruebas sin tocar
# la cadena de conexión.
# MONGODB_DB="planificador"

# Firma las cookies de sesión. Genera uno con:  openssl rand -base64 32
# Cambiarlo invalida todas las sesiones abiertas.
BETTER_AUTH_SECRET="cámbiame"

# Origen público del sitio, sin barra final. En local es el del servidor de
# desarrollo; en Vercel, tu dominio.
BETTER_AUTH_URL="http://localhost:4321"

# --- Recordatorios por Telegram (opcional) ---------------------------------
# Sin estas tres el calendario funciona igual; solo deja de haber avisos.

# El token que da @BotFather al crear el bot con /newbot. Es la llave entera
# del bot: si acaba en un commit, revócalo con /revoke, no basta con borrarlo.
# TELEGRAM_BOT_TOKEN="123456789:AAF…"

# El usuario del bot, sin la arroba. Va dentro del enlace que abre el chat.
# TELEGRAM_BOT_USERNAME="mi_planificador_bot"

# Autoriza al programador externo a disparar el envío. Genera uno con:
#   openssl rand -hex 32
# CRON_SECRET="cámbiame"

# --- Imágenes en Cloudinary ------------------------------------------------
# Obligatorias, al revés que las de Telegram: sin ellas no se puede guardar ni
# ver ningún adjunto. Salen del panel de Cloudinary, en *Settings → API Keys*.

CLOUDINARY_CLOUD_NAME="mi-nube"
CLOUDINARY_API_KEY="123456789012345"

# Firma las subidas y las URLs. Con ella se puede subir, borrar y firmar
# cualquier cosa de la nube: nunca al navegador y nunca a un commit.
CLOUDINARY_API_SECRET="cámbiame"

# La *API Environment Variable* (`CLOUDINARY_URL`) NO se usa y no hace falta
# ponerla: el SDK la buscaría en `process.env`, donde el `.env` no llega en
# `astro dev`, así que funcionaría en producción y no en local. Las tres de
# arriba se declaran en `astro.config.mjs` y se configuran a mano.
