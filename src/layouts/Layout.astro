---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Loading from '../components/Loading.astro';
import { DARK_CLASS, THEME_KEY } from '../lib/theme';
import { PALETTE_KEY } from '../lib/palette';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Dashboard de planificación para 2026 y 2027.' } =
  Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    {/* El tema, antes que nada.

        Este script es bloqueante y va en el `<head>` a propósito: decide la
        clase de `<html>` antes de que exista el `<body>`, así que el navegador
        pinta el primer píxel con el tema ya puesto. Montarlo en React —o
        incluso al final del `<body>`— dejaría ver un destello blanco en cada
        recarga, que es exactamente lo que se está evitando.

        Sin nada guardado manda el sistema operativo. Se mira `!== 'light'` y no
        `=== null` para que un valor estropeado caiga también del lado del
        sistema en vez de forzar el modo claro. */}
    <script is:inline define:vars={{ key: THEME_KEY, cls: DARK_CLASS }}>
      (function () {
        function apply() {
          try {
            var saved = localStorage.getItem(key);
            var dark =
              saved === 'dark' ||
              (saved !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.classList.toggle(cls, dark);
          } catch (error) {
            /* Sin almacenamiento no hay preferencia guardada: se queda el claro. */
          }
        }

        apply();

        /* Y otra vez después de cada navegación.
           El enrutador copia los atributos del `<html>` que llega sobre el que
           hay, y el que llega viene del servidor — que no sabe nada de esta
           preferencia, porque vive en `localStorage`. Sin esto, ir de la agenda
           al calendario devolvería el tema claro de golpe. */
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    {/* Los colores retocados, por el mismo motivo y en el mismo momento que el
        tema: si esto se montara en React, el calendario se pintaría un cuadro
        con los colores de fábrica y otro con los suyos.

        No hace falta conocer los ids: lo que no case con la forma esperada se
        ignora, y lo que sobre queda en una variable que nadie pide. El
        hexadecimal **sí** se comprueba, y esa comprobación no es cosmética: el
        valor entra en una propiedad personalizada del documento y se sustituye
        tal cual allí donde se use, así que un texto cualquiera podría colar
        más CSS del que aparenta. */}
    <script is:inline define:vars={{ key: PALETTE_KEY }}>
      (function () {
        function apply() {
          try {
            var saved = JSON.parse(localStorage.getItem(key) || '{}');
            for (var id in saved) {
              var tone = saved[id] && saved[id].hex;
              if (/^[a-z]+$/.test(id) && /^#[0-9a-f]{6}$/i.test(tone)) {
                document.documentElement.style.setProperty('--day-' + id, tone);
              }
            }
          } catch (error) {
            /* Sin almacenamiento o con algo estropeado: paleta de fábrica. */
          }
        }

        apply();
        /* Lo mismo que el tema: estos tonos son un `style` en línea del
           `<html>`, y el enrutador lo sustituye entero en cada navegación. */
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    {/* El enrutador de cliente. Sin él la navegación es una recarga completa
        del navegador, y entonces no existe ningún hueco que llenar —ni los
        eventos `astro:*` con los que `Loading` se entera de que lo hay. */}
    <ClientRouter />

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">
    <Loading />
    <slot />
  </body>
</html>
