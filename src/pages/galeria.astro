---
import Layout from '../layouts/Layout.astro';
import GalleryView from '../components/GalleryView';

// Igual que el calendario: la sesión se resuelve por petición.
export const prerender = false;

const user = Astro.locals.user!;
---

<Layout
  title="Galería · Planificador 2026"
  description="Todas las imágenes adjuntas a las notas del Planificador 2026."
>
  {/* La barra de navegación y el <main> los dibuja el componente: la
      barra debe quedar fuera del contenedor para cruzar la pantalla. */}
  <GalleryView user={{ name: user.name, email: user.email }} client:load />
</Layout>
