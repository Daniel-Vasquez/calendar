---
import Layout from '../layouts/Layout.astro';
import CalendarDashboard from '../components/CalendarDashboard';
import { BOOT_STYLE_ID, EXPANSION_KEY, LEGACY_MONTHS } from '../lib/collapse';
import {
  DAY_PARAM,
  defaultYear,
  isCalendarYear,
  parseYear,
  YEAR_PARAM,
  yearOf,
} from '../lib/calendar';

// Con sesión de por medio ya no se puede prerenderizar: el middleware necesita
// una petición real para saber quién entra, y en las páginas prerenderizadas
// no llega a correr.
export const prerender = false;

// Si el middleware ha dejado pasar la petición, hay usuario: sin él habría
// desviado a `/login` antes de llegar aquí.
const user = Astro.locals.user!;

// El año de la rejilla se decide **aquí**, antes de pintar nada, y no en el
// cliente al hidratar: así el HTML que baja ya trae los doce meses correctos y
// no se ve 2026 un instante antes de que React lo cambie por 2027.
//
// Manda `?year=`, que es lo que deja el conmutador al cambiar de pestaña. Si no
// viene, lo dice el día que se pide abrir —`/?day=2027-03-15` lleva su año
// dentro, y es como llegan los enlaces de la galería y de los recordatorios—, y
// en último término el año corriente si el calendario lo cubre.
const day = Astro.url.searchParams.get(DAY_PARAM);
const dayYear = day ? yearOf(day) : NaN;
const initialYear =
  parseYear(Astro.url.searchParams.get(YEAR_PARAM)) ??
  (isCalendarYear(dayYear) ? dayYear : defaultYear());
---

<Layout title="Planificador 2026">
  {/* El HTML llega con los doce meses abiertos y React aplica los plegados
      al hidratar. Para que no se vean abrir y cerrarse por el camino, este
      script bloqueante lee localStorage antes de que exista el calendario y
      deja una hoja con su aspecto plegado —cuerpo oculto, chevron girado—
      que CalendarDashboard retira en cuanto el estado es suyo. Los ganchos
      (`data-month`, `.month-body`, `.month-chevron`) son los de MonthCard.

      Las reglas se escriben para **todos** los años guardados, sin mirar cuál
      se está pintando: las tarjetas del otro no están en la página, así que su
      selector no encuentra nada y sobra el trabajo de filtrarlas aquí. */}
  <script
    slot="head"
    is:inline
    define:vars={{
      key: EXPANSION_KEY,
      id: BOOT_STYLE_ID,
      legacy: LEGACY_MONTHS,
    }}
  >
    try {
      var saved = JSON.parse(localStorage.getItem(key) || '{}');
      var rules = '';
      for (var month in saved) {
        if (saved[month] !== false) continue;

        // El formato anterior llevaba el mes por su nombre y ningún año, y
        // sigue ahí hasta que React vuelva a guardar. Sin traducirlo, la
        // primera carga tras el cambio pintaría abierto lo que estaba plegado
        // —y lo cerraría un instante después—, que es el parpadeo que este
        // script existe para evitar.
        var at = legacy.months.indexOf(month);
        var name = at < 0 ? month : legacy.year + '-' + (at < 9 ? '0' : '') + (at + 1);

        // `2026-01` y nada más: la clave acaba dentro de un selector.
        if (!/^\d{4}-\d{2}$/.test(name)) continue;

        rules +=
          '[data-month="' + name + '"]>.month-body{display:none!important}' +
          '[data-month="' + name + '"] .month-chevron{rotate:-90deg!important}';
      }
      if (rules) {
        var style = document.createElement('style');
        style.id = id;
        style.textContent = rules;
        document.head.appendChild(style);
      }
    } catch (error) {
      /* Sin almacenamiento no hay nada guardado: se dibuja todo abierto. */
    }
  </script>

  {/* La barra de navegación y el <main> los dibuja el componente: la
      barra debe quedar fuera del contenedor para cruzar la pantalla. */}
  <CalendarDashboard
    user={{ name: user.name, email: user.email }}
    initialYear={initialYear}
    client:load
  />
</Layout>
